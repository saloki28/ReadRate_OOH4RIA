@model WebApplication_ReadRate.Models.AdministradorViewModel

@{
    ViewData["Title"] = "Create";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Crear Administrador</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Crear Nuevo Administrador</h1>
    </header>

    <main class="container my-5">
        <section class="card shadow-orange-lg">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <article class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                        <div class="form-text"> Escribe el nombre del administrador (máximo 200 caracteres) </div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-text">Escribe el email</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div class="form-text">Escribe la contraseña</div>
                    </article>

                    <article class="mb-4">
                        <label asp-for="FotoFile" class="form-label">Foto del Administrador</label>
                        <input asp-for="FotoFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="FotoFile" class="text-danger"></span>
                        <div class="form-text">Selecciona una foto para el administrador (opcional, por defecto se usará usuarioDefault.webp)</div>
                    </article>

                    <article class="d-flex gap-3 justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i>Volver al listado</a>
                        <input type="submit" value="Crear administrador" class="btn btn-primary px-5" />
                    </article>
                </form>
            </div>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
