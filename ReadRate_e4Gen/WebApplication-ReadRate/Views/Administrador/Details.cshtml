@model WebApplication_ReadRate.Models.AdministradorViewModel

@{
    ViewData["Title"] = "Detalles del administrador";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Detalles del administrador</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Detalles del Administrador</h1>
    </header>

    <main class="container my-5">
        <section class="details-card card shadow-lg">

            @if(Model != null && !string.IsNullOrEmpty(Model.FotoUrl))
            {
                <div class="detail-label fw-bold">Foto</div>
                <div class="detail-row-foto d-flex justify-content-center align-items-center mb-4">
                    <img src="@Model.FotoUrl" alt="Foto de @Model.Nombre" style="max-width: 300px;">
                </div>
            }
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Nombre)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.Nombre)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Email)</div>
                <div class="detail-value text-end"><a href="mailto:@Model.Email">@Model.Email</a></div>
            </article>

            <article class="form-actions d-flex gap-3 justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-5">Editar administador</a>
            </article>
        </section> 
    </main>
</body>
</html>