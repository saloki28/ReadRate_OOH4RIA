@model IEnumerable<WebApplication_ReadRate.Models.AdministradorViewModel>

@{
    ViewData["Title"] = "Index";
}

<header class="page-header">
    <h1>MÉTRICAS</h1>
</header>

<section class="container">
    <!-- Tarjetas de estadísticas -->
    <div class="row mb-4">
        <div class="col-md-6">
            <article class="bg-white p-4 rounded-3 shadow-orange text-center">
                <h2 class="section-title mb-2" style="color: #ff6f00;">Clubes activos</h2>
                <p class="mb-2">Total de clubes activos:</p>
                <p class="display-1 fw-bold mb-0" style="color: #ff6f00;">@ViewData["TotalClubes"]</p>
            </article>
        </div>
        <div class="col-md-6">
            <article class="bg-white p-4 rounded-3 shadow-orange text-center">
                <h2 class="section-title mb-2" style="color: #ff6f00;">Libros publicados</h2>
                <p class="mb-2">Total de libros publicados:</p>
                <p class="display-1 fw-bold mb-0" style="color: #ff6f00;">@ViewData["TotalLibros"]</p>
            </article>
        </div>
    </div>

    <!-- Gráficos -->
    <div class="row mb-4">
        <div class="col-md-4">
            <article class="bg-white p-4 rounded-3 shadow-orange">
                <h2 class="section-title mb-3">Números Totales</h2>
                <div class="text-center">
                    <img src="~/images/graficos/numeros-totales.png" alt="Números totales" class="img-fluid" />
                </div>
            </article>
        </div>
        <div class="col-md-4">
            <article class="bg-white p-4 rounded-3 shadow-orange">
                <h2 class="section-title mb-3">Top 5 Libros con Más Reseñas</h2>
                <div class="text-center">
                    <img src="~/images/graficos/libros-mas-resenas.png" alt="Libros con más reseñas" class="img-fluid" />
                </div>
            </article>
        </div>
        <div class="col-md-4">
            <article class="bg-white p-4 rounded-3 shadow-orange">
                <h2 class="section-title mb-3">Usuarios</h2>
                <div class="text-center">
                    <img src="~/images/graficos/usuarios-por-rol.png" alt="Gráfico de usuarios por rol" class="img-fluid" />
                </div>
            </article>
        </div>
    </div>
</section>
