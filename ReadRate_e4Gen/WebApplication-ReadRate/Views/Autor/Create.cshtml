@model WebApplication_ReadRate.Models.AutorViewModel

@{
    ViewData["Title"] = "Crear Autor";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Crear Autor</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Crear Nuevo Autor</h1>
    </header>

    <main class="container my-5">
        <section class="card shadow-orange-lg">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    @* Campos ocultos con valores por defecto *@
                    <input type="hidden" asp-for="Rol" value="1" />
                    <input type="hidden" asp-for="NumeroSeguidores" value="0" />
                    <input type="hidden" asp-for="CantidadLibrosPublicados" value="0" />
                    <input type="hidden" asp-for="ValoracionMedia" value="0" />

                    <article class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Ej: autor@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-text">Formato correo electrónico</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label"></label>
                        <input asp-for="NombreUsuario" class="form-control" placeholder="Ej: Juan123" />
                        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                        <div class="form-text">Nombre de usuario de no más de 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="FechaNacimiento" class="form-label"></label>
                        <input asp-for="FechaNacimiento" class="form-control" type="date" />
                        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                        <div class="form-text">Fecha en formato dd/mm/yyyy</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="CiudadResidencia" class="form-label"></label>
                        <input asp-for="CiudadResidencia" class="form-control" placeholder="Elche, Alicante..." />
                        <span asp-validation-for="CiudadResidencia" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="PaisResidencia" class="form-label"></label>
                        <input asp-for="PaisResidencia" class="form-control" placeholder="España, Portugal..." />
                        <span asp-validation-for="PaisResidencia" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="Pass" class="form-label"></label>
                        <input asp-for="Pass" class="form-control" placeholder="Ej: password123" type="password" />
                        <span asp-validation-for="Pass" class="text-danger"></span>
                        <div class="form-text">Contraseña de acceso</div>
                    </article>

                    <article class="mb-4">
                        <label asp-for="FotoFile" class="form-label"></label>
                        <input asp-for="FotoFile" class="form-control" type="file" />
                        <span asp-validation-for="FotoFile" class="text-danger"></span>
                        <div class="form-text">Imagen del perfil (formatos aceptados: .jpg, .png, .gif)</div>
                    </article>

                    <article class="d-flex gap-3 justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                        <input type="submit" value="Crear autor" class="btn btn-primary px-5" />
                    </article>
                </form>
            </div>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}