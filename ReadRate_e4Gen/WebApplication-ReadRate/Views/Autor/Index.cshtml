@model IEnumerable<WebApplication_ReadRate.Models.AutorViewModel>

@{
    ViewData["Title"] = "Index";
}

@{
    var usuarioId = Context.Session.GetInt32("UsuarioId");
    var usuarioRol = Context.Session.GetString("UsuarioRol");
    bool esPropioAutor = Model != null && usuarioId.HasValue && Model.Any() && Model.First().IdUsuario == usuarioId.Value;
}

<header class="page-header">
    <h1>@(esPropioAutor ? "TU ÁREA PERSONAL" : "PERFIL DE AUTOR")</h1>
</header>

<main class="container my-5">
    @if (Model != null && Model.Any())
    {
        var autor = Model.First();
        
        @* Información del Autor *@
        <section class="card shadow-orange-lg mb-5">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-3 text-center mb-3 mb-md-0">
                        <article class="autor-photo-wrapper">
                            @if (!string.IsNullOrEmpty(autor.FotoUrl))
                            {
                                <img src="@autor.FotoUrl" alt="Foto de @autor.NombreUsuario" class="rounded-circle" style="width: 180px; height: 180px; object-fit: cover; border: 4px solid #ff9800; box-shadow: 0 4px 12px rgba(255,111,0,0.3);">
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 180px; height: 180px; border: 4px solid #ff9800; margin: 0 auto;">
                                    <span class="text-muted" style="font-size: 3rem;">@autor.NombreUsuario.Substring(0, 1).ToUpper()</span>
                                </div>
                            }
                        </article>
                        <h3 class="mt-3 text-orange-dark">@autor.NombreUsuario</h3>
                    </div>
                    <div class="col-md-9">
                        <div class="row text-center">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <article class="stats-card">
                                    <h2 class="text-orange-dark mb-1">@autor.CantidadLibrosPublicados</h2>
                                    <p class="text-muted mb-0">Publicados</p>
                                </article>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <article class="stats-card">
                                    <h2 class="text-orange-dark mb-1">@autor.NumeroSeguidores</h2>
                                    <p class="text-muted mb-0">Seguidores</p>
                                </article>
                            </div>
                            <div class="col-md-4">
                                <article class="stats-card">
                                    <h2 class="text-orange-dark mb-1"><partial name="_StarRating" model="autor.ValoracionMedia" /></h2>
                                    <p class="text-muted mb-0">Valoración Media</p>
                                </article>
                            </div>
                        </div>
                        @if (usuarioRol == "lector" && !esPropioAutor)
                        {
                            <div class="d-flex align-items-center justify-content-center mt-4">
                                @if (ViewBag.YaSiguiendoAutor == true)
                                {
                                    <form asp-action="DejarDeSeguirAutor" asp-controller="Autor" method="post" class="w-100">
                                        <input type="hidden" name="autorId" value="@autor.IdUsuario" />
                                        <button type="submit" class="btn-action delete w-100"><i class="fas fa-user-minus"></i> Dejar de Seguir</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="SeguirAutor" asp-controller="Autor" method="post" class="w-100">
                                        <input type="hidden" name="autorId" value="@autor.IdUsuario" />
                                        <button type="submit" class="btn-action w-100"><i class="fas fa-user-plus"></i> Seguir</button>
                                    </form>
                                }
                            </div>
                        }
                        @if (esPropioAutor)
                        {
                            <div class="row mt-4 align-items-center">
                                <div class="col-6">
                                    @* TODO *@
                                        <a asp-controller="Autor" asp-action="Edit" asp-route-id="@autor.IdUsuario" class="btn-profile-edit w-100"> 
                                        <i class="fas fa-edit"></i> Editar Información
                                    </a>
                                </div>
                                <div class="col-6">
                                     <a asp-controller="Autor" asp-action="Delete" asp-route-id="@autor.IdUsuario" class="btn-profile-delete w-100">
                                        <i class="fas fa-trash-alt"></i> Eliminar Cuenta
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>

        @* Sección de Libros del Autor *@
        <section class="mb-5">
            <h2 class="section-title mb-4">@(esPropioAutor ? "LIBROS PUBLICADOS" : "LIBROS PUBLICADOS")</h2>
        
            <div class="books-grid">
            @if (ViewBag.LibrosAutor != null && ViewBag.LibrosAutor.Count > 0)
            {
                foreach (var libro in ViewBag.LibrosAutor)
                {
                    <article class="book-card">
                        <div class="book-cover">
                            @if (!string.IsNullOrEmpty(libro.FotoPortadaUrl))
                            {
                                <img src="@libro.FotoPortadaUrl" alt="Portada de @libro.Titulo" style="width: 100%; height: 100%; object-fit: contain;">
                            }
                            else
                            {
                                <span>Portada</span>
                            }
                        </div>
                        <div class="book-info">
                            <div class="book-title">@libro.Titulo</div>
                            <div class="book-meta">
                                <strong>Valoración:</strong> <partial name="_StarRating" model="libro.ValoracionMedia" /> <br />
                            </div>
                            <div class="book-actions">
                                @if (esPropioAutor)
                                {
                                    <a asp-controller="Libro" asp-action="Delete" asp-route-id="@libro.Id" class="btn-action delete"><i class="fas fa-trash-alt"></i> Eliminar</a>
                                }
                                else{
                                    <a asp-controller="Libro" asp-action="Details" asp-route-id="@libro.Id" class="btn-action"><i class="fas fa-eye"></i> Ver Detalles</a>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
                @if (esPropioAutor)
                {
                    <a asp-controller="Libro" asp-action="Create" class="text-decoration-none">
                        <div class="book-card add-card">
                            <div class="add-content">
                                <i class="fas fa-plus-circle fa-4x text-orange mb-3"></i>
                                <p class="text-orange fw-bold mb-0">Añadir Libro</p>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </section>

        @* Sección de Reseñas *@
        <section>
            <h2 class="section-title mb-4">ÚLTIMAS RESEÑAS DE PUBLICACIONES</h2>
            @if (ViewBag.ReseñasAutor != null && ViewBag.ReseñasAutor.Count > 0)
            {
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    @foreach (var reseña in ViewBag.ReseñasAutor)
                    {
                        <div class="col">
                            <article class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        @if (!string.IsNullOrEmpty(reseña.LectorFoto))
                                        {
                                            <img src="@reseña.LectorFoto" alt="Foto de @reseña.LectorNombre" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; font-size: 1.5rem; font-weight: bold;">
                                                @reseña.LectorNombre?.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 text-orange-dark">@reseña.LectorNombre</h6>
                                            <small class="text-muted">Reseña de: <strong>@reseña.LibroNombre</strong></small>
                                        </div>
                                    </div>
                                    <p class="card-text mb-2">@reseña.Opinion</p>
                                    <div class="mb-2">
                                        <partial name="_StarRating" model="reseña.Valoracion" />
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    @(esPropioAutor ? "Aún no hay reseñas de tus libros." : "Este autor aún no tiene reseñas en sus libros.")
                </div>
            }
        </section>
    }
    else
    {
        <article class="alert alert-danger text-center">
            No se encontró información del autor.
        </article>
    }
</main>