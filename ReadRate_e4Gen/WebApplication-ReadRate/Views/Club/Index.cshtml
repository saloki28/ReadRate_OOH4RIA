@model IEnumerable<WebApplication_ReadRate.Models.ClubViewModel>

@{
    ViewData["Title"] = "Index";
}
<header class="page-header">
    <h1>Listado de Clubs de Lectura</h1>
</header>

<section class="container">
    <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
        <h2 class="section-title mb-0">Todos los Clubs de Lectura</h2>
        <a asp-action="Create" class="btn-create">+ Crear nuevo club</a>
    </article>

    <article class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <article class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 d-flex flex-column">
                        <div class="book-cover">
                            @if(!string.IsNullOrEmpty(item.FotoUrl))
                            {
                                <img src="@item.FotoUrl" alt="Foto de @item.Nombre" class="card-img-top" style="height: 250px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                    <span class="text-muted">Sin foto</span>
                                </div>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-orange-dark">@Html.DisplayFor(modelItem => item.Nombre)</h5>
                            <div class="card-text small mb-3 flex-grow-1">
                                <div class="mb-1"><strong>Descripción:</strong> @Html.DisplayFor(modelItem => item.Descripcion)</div>
                                <div class="mb-1"><strong>Número Máximo de Miembros:</strong> @Html.DisplayFor(modelItem => item.NumeroMax) Lectores</div>
                                <div class="mb-1"><strong>Número de Miembros Actuales:</strong> @Html.DisplayFor(modelItem => item.Miembros) Lectores</div>
                                <div class="mb-1"><strong>Enlace a Discord:</strong> @Html.DisplayFor(modelItem => item.Enlace)</div>
                            </div>
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit flex-fill text-center">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete flex-fill text-center">Borrar</a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="col-12">
                <div class="alert alert-info text-center">
                    No hay clubs en el listado. ¡Añade el primero!
                </div>
            </article>
        }
    </article>
</section>
