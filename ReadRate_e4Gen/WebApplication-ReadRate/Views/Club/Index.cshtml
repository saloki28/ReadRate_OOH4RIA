@model IEnumerable<WebApplication_ReadRate.Models.ClubViewModel>

@{
    ViewData["Title"] = "Index";
}

<header class="page-header">
    <h1>Listado de Clubs de Lectura</h1>
</header>

<section class="container">
    <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
        <h2 class="section-title mb-0">Todos los Clubs de Lectura</h2>
        <a asp-action="Create" class="btn-create">+ Crear nuevo club</a>
    </article>

    <article class="vertical-list">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <article class="card mb-4 shadow event-horizontal">
                    <div class="row g-0 h-100">
                        <article class="col-12 col-md-4">
                            @if(!string.IsNullOrEmpty(item.FotoUrl))
                            {
                                <img src="@item.FotoUrl" alt="Foto de @item.Nombre" class="img-fluid h-100 w-100" style="object-fit: cover;">
                            }
                            else
                            {
                                <div class="event-cover-placeholder d-flex align-items-center justify-content-center h-100">
                                    Sin Foto
                                </div>
                            }
                        </article>

                        <article class="col-12 col-md-8">
                            <div class="event-horizontal-body card-body d-flex flex-column h-100">

                                <h3 class="event-title card-title">@Html.DisplayFor(modelItem => item.Nombre)</h3>

                                <p class="event-description card-text">
                                    <strong>Descripción:</strong> @Html.DisplayFor(modelItem => item.Descripcion)
                                </p>

                                <footer class="event-footer-actions mt-auto d-flex justify-content-between align-items-center">

                                    @{
                                        var usuarioRol = Context.Session.GetString("UsuarioRol");
                                        var usuarioId = Context.Session.GetInt32("UsuarioId");
                                        bool clubCompleto = item.Miembros >= item.NumeroMax;
                                        
                                        // TODO: Implementar lógica para verificar si el lector está suscrito
                                        // bool estaSuscrito = /* Llamar a método que verifique si usuarioId está en la lista de miembros del club */;
                                        bool estaSuscrito = false; // Placeholder - Cambiar por la lógica real
                                    }

                                    @if (usuarioRol == "lector" && estaSuscrito)
                                    {
                                        <!-- Lector ya suscrito: mostrar botones Acceder y Darse de baja -->
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center">
                                                Acceder
                                            </a>
                                            <a asp-action="Desuscribirse" asp-route-id="@item.Id" class="btn-action delete flex-fill text-center">
                                                @* TODO: Implementar acción Desuscribirse en ClubController *@
                                                ¡Darme de baja!
                                            </a>
                                        </div>
                                    }
                                    else if (clubCompleto)
                                    {
                                        <!-- Club completo: botón deshabilitado con estilo diferente -->
                                        <button class="btn-club-completo" disabled>
                                            Club completo
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- Club con cupo disponible: botón normal de suscribirse -->
                                        <a asp-action="Suscribirse" asp-route-id="@item.Id" class="btn-black">
                                            @* TODO: Implementar acción Suscribirse en ClubController *@
                                            ¡Suscribirme al club!
                                        </a>
                                    }

                                    <div class="aforo-text">
                                        Cupo actual: @Html.DisplayFor(modelItem => item.Miembros) / @Html.DisplayFor(modelItem => item.NumeroMax) Miembros
                                    </div>
                                </footer>
                            </div>
                        </article>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="col-12">
                <div class="alert alert-info text-center">
                    No hay clubs disponibles.
                </div>
            </article>
        }
    </article>
</section>