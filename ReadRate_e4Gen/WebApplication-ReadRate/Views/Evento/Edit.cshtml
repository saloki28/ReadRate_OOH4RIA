@model WebApplication_ReadRate.Models.EventoViewModel

@{
    ViewData["Title"] = "Editar Evento";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Editar Evento</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Editar Evento</h1>
    </header>

    <main class="container my-5">
        <section class="card shadow-orange-lg">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Foto" />

                    <article class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Introduce el nombre..." />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                        <div class="form-text">Nombre de no más de 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="TextoDescripcion" class="form-label"></label>
                        <textarea asp-for="TextoDescripcion" class="form-control" rows="4" placeholder="Escribe aquí el cuerpo del evento..."></textarea>
                        <span asp-validation-for="TextoDescripcion" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="FechaPublicacion" class="form-label"></label>
                        <input asp-for="FechaPublicacion" class="form-control" type="date" />
                        <span asp-validation-for="FechaPublicacion" class="text-danger"></span>
                        <div class="form-text">Fecha en formato dd/mm/yyyy</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="HoraEvento" class="form-label"></label>
                        <input asp-for="HoraEvento" class="form-control" type="time" value="@Model.HoraEvento.ToString("HH:mm")" />
                        <span asp-validation-for="HoraEvento" class="text-danger"></span>
                        <div class="form-text">Hora en formato HH:MM</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="Ubicacion" class="form-label"></label>
                        <textarea asp-for="Ubicacion" class="form-control" rows="4" placeholder="Escribe aquí la ubicación..."></textarea>
                        <span asp-validation-for="Ubicacion" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="AforoMaximo" class="form-label"></label>
                        <input asp-for="AforoMaximo" class="form-control" type="number" min="1" max="10000" placeholder="Ej: 320" />
                        <span asp-validation-for="AforoMaximo" class="text-danger"></span>
                        <div class="form-text">Aforo entre 1 y 10000</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="AforoActual" class="form-label"></label>
                        <input asp-for="AforoActual" class="form-control" type="number" min="0" max="10000" placeholder="Ej: 320" />
                        <span asp-validation-for="AforoActual" class="text-danger"></span>
                        <div class="form-text">Aforo entre 0 y 10000</div>
                    </article>

                    <article class="mb-4">
                        <label asp-for="FotoFichero" class="form-label">Cambiar Imagen del Evento</label>
                        <input asp-for="FotoFichero" class="form-control" type="file" accept="image/*" />
                        <span asp-validation-for="FotoFichero" class="text-danger"></span>
                        <div class="form-text">Deja en blanco para mantener la foto actual</div>
                    </article>

                    <article class="d-flex gap-3 justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                        <input type="submit" value="Guardar cambios" class="btn btn-primary px-5" />
                    </article>
                </form>
            </div>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
