@model IEnumerable<WebApplication_ReadRate.Models.EventoViewModel>

@{
    ViewData["Title"] = "Index Eventos";
}

<header class="page-header">
    <h1>EVENTOS LITERARIOS</h1>
</header>

<section class="container">
    <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
        <h2 class="section-title mb-0">Todos los Eventos</h2>
        <a asp-action="Create" class="btn-create">+ Crear nuevo evento</a>
    </article>

    <div class="vertical-list">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <article class="event-horizontal">

                    <figure class="event-horizontal-img">
                        @if (!string.IsNullOrEmpty(item.Foto))
                        {
                            <img src="@item.Foto" alt="@item.Nombre" />
                        }
                        else
                        {
                            <div class="event-cover-placeholder">

                                Foto Evento
                            </div>
                        }
                    </figure>

                    <div class="event-horizontal-body">

                        <h3 class="event-title">@Html.DisplayFor(modelItem => item.Nombre)</h3>

                        <p class="event-description">
                            <strong>Descripción:</strong> @Html.DisplayFor(modelItem => item.TextoDescripcion)
                        </p>

                        <div class="meta-box-container">
                            <div class="meta-box">
                                <strong>Fecha:</strong> @item.FechaPublicacion.ToString("dd/MM/yy")
                            </div>
                            <div class="meta-box">
                                <strong>Hora:</strong> @item.HoraEvento.ToString("HH:mm")
                            </div>
                            <div class="meta-box">
                                <strong>Ubicación:</strong> @Html.DisplayFor(modelItem => item.Ubicacion)
                            </div>
                        </div>

                        <footer class="event-footer-actions">

                            @*Para admin: *@
                            @* <div>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete">Borrar</a>
                            </div> *@

                            <a asp-action="Inscribirse" asp-route-id="@item.Id" class="btn-black">
                                ¡Inscribirme al evento!
                            </a>

                            <div class="aforo-text">
                                Aforo: @Html.DisplayFor(modelItem => item.AforoActual) / @Html.DisplayFor(modelItem => item.AforoMaximo)
                            </div>
                        </footer>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="col-12">
                <div class="alert alert-info text-center">
                    No hay eventos disponibles.
                </div>
            </article>
        }
    </article>
</section>