@model IEnumerable<WebApplication_ReadRate.Models.EventoViewModel>

@{
    ViewData["Title"] = "Index Eventos";
    var rolUsuario = Context.Session.GetString("UsuarioRol");
}

<header class="page-header">
    <h1>Listado de Eventos</h1>
</header>

<section class="container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (rolUsuario == "administrador")
    {
        <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
            <h2 class="section-title mb-0">Todos los Eventos</h2>
            @if (Context.Session.GetString("UsuarioRol") == "administrador")
            {
                <a asp-action="Create" class="btn-create"><i class="fas fa-plus"></i> Crear nuevo evento</a>
            }
        </article>
    }

    <article class="vertical-list">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <article class="card mb-4 shadow event-horizontal">
                    <div class="row g-0 h-100">
                        <article class="col-12 col-md-4">
                            @if (!string.IsNullOrEmpty(item.Foto))
                            {
                                <img src="@item.Foto" alt="@item.Nombre" class="img-fluid h-100 w-100" style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="event-cover-placeholder d-flex align-items-center justify-content-center h-100">
                                    Sin Foto
                                </div>
                            }
                        </article>

                        <article class="col-12 col-md-8">
                            <div class="event-horizontal-body card-body d-flex flex-column h-100">

                                <h3 class="event-title card-title">@Html.DisplayFor(modelItem => item.Nombre)</h3>

                                <p class="event-description card-text">
                                    <strong>Descripción:</strong> @Html.DisplayFor(modelItem => item.TextoDescripcion)
                                </p>

                                <div class="meta-box-container d-flex flex-wrap gap-3 mb-3">
                                    <div class="meta-box">
                                        <strong><i class="fas fa-calendar-alt"></i> Fecha:</strong> @item.FechaPublicacion.ToString("dd/MM/yy")
                                    </div>
                                    <div class="meta-box">
                                        <strong><i class="fas fa-clock"></i> Hora:</strong> @item.HoraEvento.ToString("HH:mm")
                                    </div>
                                    <div class="meta-box">
                                        <strong><i class="fas fa-map-marker-alt"></i> Ubicación:</strong> @Html.DisplayFor(modelItem => item.Ubicacion)
                                    </div>
                                </div>

                                <footer class="event-footer-actions mt-auto d-flex justify-content-between align-items-center">

                                    <!-- Botones de los evento según el rol -->
                                    @if (rolUsuario == "administrador")
                                    {
                                        <!-- Admin: Eliminar -->
                                        <div class="d-flex gap-2 mt-auto">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center">
                                                <i class="fas fa-eye"></i> Acceder
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action flex-fill text-center"><i class="fas fa-edit"></i> Editar</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action flex-fill text-center"><i class="fas fa-trash-alt"></i> Eliminar</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Usuarios regulares (lector, autor, visitante) ven botón de inscripción -->
                                        var eventoCompleto = item.AforoActual >= item.AforoMaximo;
                                        var eventosInscritos = ViewBag.EventosInscritos as List<int> ?? new List<int>();
                                        var estaInscrito = eventosInscritos.Contains(item.Id);
                                        
                                        if ((rolUsuario == "lector" || rolUsuario == "autor") && estaInscrito)
                                        {
                                            <!-- Usuario inscrito: mostrar botones Acceder y Desinscribirse -->
                                            <div class="d-flex gap-2">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center">
                                                    <i class="fas fa-eye"></i> Acceder
                                                </a>
                                                <a asp-action="Desinscribirse" asp-route-id="@item.Id" class="btn-action delete flex-fill text-center">
                                                    <i class="fas fa-user-minus"></i> ¡Darme de baja!
                                                </a>
                                            </div>
                                        }
                                        else if (eventoCompleto)
                                        {
                                            <button disabled class="btn-evento-completo">
                                                Aforo completo
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-action="Inscribirse" asp-route-id="@item.Id" class="btn-black">
                                                ¡Inscribirme al evento!
                                            </a>
                                        }
                                    }

                                    <div class="aforo-text">
                                        Aforo actual: @Html.DisplayFor(modelItem => item.AforoActual) / @Html.DisplayFor(modelItem => item.AforoMaximo) Inscritos
                                    </div>
                                </footer>
                            </div>
                        </article>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="col-12">
                <div class="alert alert-info text-center" style="background: #ffffff; border-radius: 15px; color: #999; border: none;">
                    No hay eventos disponibles.
                </div>
            </article>
        }
    </div>
</section>