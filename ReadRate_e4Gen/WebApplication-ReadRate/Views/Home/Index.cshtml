@model IEnumerable<ReadRate_e4Gen.ApplicationCore.EN.ReadRate_E4.LibroEN>
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Inicio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="header">
        <h1>Read&Rate</h1>
        <p>Descubre los últimos libros publicados y comparte tu opinión</p>
    </header>
    <main class="container">
        <section>
            <h2 class="section-title mb-4">Últimas Novedades Publicadas</h2>
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <article class="col-12 col-sm-6 col-md-4 col-lg-5col">
                            <div class="card h-100 d-flex flex-column">
                                <div class="book-cover">
                                    @if(!string.IsNullOrEmpty(item.FotoPortada))
                                    {
                                        <img src="@item.FotoPortada" alt="Portada de @item.Titulo" class="card-img-top" style="height: 250px; object-fit: contain;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                            <span class="text-muted">Sin portada</span>
                                        </div>
                                    }
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-orange-dark">@Html.DisplayFor(modelItem => item.Titulo)</h5>
                                    <strong class="card-subtitle text-muted small mb-2">@Html.DisplayFor(modelItem => item.AutorPublicador.NombreUsuario)</strong>
                                    <div class="card-text small mb-3 flex-grow-1">
                                        <div class="mb-1"><strong>Género:</strong> @Html.DisplayFor(modelItem => item.Genero)</div>
                                        <div class="mb-1"><strong>Edad:</strong> +@Html.DisplayFor(modelItem => item.EdadRecomendada) años</div>
                                        <div class="mb-1"><strong>Páginas:</strong> @Html.DisplayFor(modelItem => item.NumPags)</div>
                                        <div class="mb-1"><strong>Valoración Media:</strong> @Html.DisplayFor(modelItem => item.ValoracionMedia) / 5</div>
                                        <div class="mb-1"><strong>Publicación:</strong> @item.FechaPublicacion?.ToString("dd/MM/yyyy")</div>
                                        @* <div class="mt-2">@Html.DisplayFor(modelItem => item.Sinopsis)</div> *@
                                    </div>
                                    <div class="d-flex gap-2 mt-auto">
                                        <a class="btn-action flex-fill text-center" asp-controller="Libro" asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <article class="col-12">
                        <div class="alert alert-info text-center">
                            Aún no existen libros publicados.
                        </div>
                    </article>
                }
            </div>
            <hr class="hr" style= "margin-top: 4em; margin-bottom: 4em;" />

            @* SECCION DE AUTORES DEL MOMENTO *@
            <h2 class="section-title mb-4">Autores Bestseller del Momento</h2>
            <partial name="_Autor" model="ViewBag.Autores" />
        </section> 
    </main>
</body>
</html>