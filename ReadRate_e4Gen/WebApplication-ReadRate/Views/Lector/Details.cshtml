@model WebApplication_ReadRate.Models.LectorViewModel

@{
    ViewData["Title"] = "Detalles del Lector";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Detalles del Lector</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Detalles del Lector</h1>
    </header>

    <main class="container my-5">
        <section class="details-card card shadow-lg">
            
            @if(Model != null && !string.IsNullOrEmpty(Model.FotoUrl))
            {
                <div class="detail-label fw-bold">Foto</div>
                <div class="detail-row-foto d-flex justify-content-center align-items-center mb-4">
                    <img src="@Model.FotoUrl" alt="Foto del lector" style="max-width: 300px;">
                </div>
            }
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Email)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.Email)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.NombreUsuario)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.NombreUsuario)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.FechaNacimiento)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.FechaNacimiento)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.CiudadResidencia)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.CiudadResidencia)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.PaisResidencia)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.PaisResidencia)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Rol) de Usuario</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.Rol)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.CantLibrosCurso)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.CantLibrosCurso)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.CantLibrosLeidos)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.CantLibrosLeidos)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.CantAutoresSeguidos)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.CantAutoresSeguidos)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.CantClubsSuscritos)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.CantClubsSuscritos)</div>
            </article>

            <article class="form-actions d-flex gap-3 justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i>Volver al listado</a>
                @if (Context.Session.GetString("UsuarioRol") == "administrador" && Model != null)
                {
                    <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-primary px-5">Editar lector</a>
                }
            </article>
        </section>
    </main>
</body>
</html>
