@model WebApplication_ReadRate.Models.LectorViewModel

@{
    ViewData["Title"] = "Editar Lector";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Editar Lector</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Editar Lector</h1>
    </header>

    <main class="container my-5">
        <section class="card shadow-orange-lg">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="IdUsuario" />
                    @* Campo oculto para el rol - siempre será "lector" (valor 2) *@
                    <input type="hidden" asp-for="Rol" value="2" />
                    <input type="hidden" asp-for="FotoUrl" />

                    <article class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Ej: lector@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-text">Formato correo electrónico</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label"></label>
                        <input asp-for="NombreUsuario" class="form-control" placeholder="Ej: Juan123" />
                        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                        <div class="form-text">Nombre de usuario de no más de 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="FechaNacimiento" class="form-label"></label>
                        <input asp-for="FechaNacimiento" class="form-control" type="date" />
                        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                        <div class="form-text">Fecha en formato dd/mm/yyyy</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="CiudadResidencia" class="form-label"></label>
                        <input asp-for="CiudadResidencia" class="form-control" placeholder="Elche, Alicante..." />
                        <span asp-validation-for="CiudadResidencia" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="PaisResidencia" class="form-label"></label>
                        <input asp-for="PaisResidencia" class="form-control" placeholder="España, Portugal..." />
                        <span asp-validation-for="PaisResidencia" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 255 caracteres</div>
                    </article>

                    @* Campo contraseña vacio *@
                    <article class="mb-3">
                        <label for="Pass" class="form-label">Contraseña</label>
                        <input type="password" id="Pass" name="Pass" class="form-control" placeholder="ej: passUser123" />
                        <span asp-validation-for="Pass" class="text-danger"></span>
                        <div class="form-text"> Contraseña obligatoria</div>
                    </article>

                    <article class="mb-4">
                        <label asp-for="FotoFile" class="form-label">Foto del lector</label>
                        @if (!string.IsNullOrEmpty(Model.FotoUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.FotoUrl" alt="Foto actual" class="img-thumbnail" style="max-width: 150px;" />
                                <p class="text-muted small">Foto actual</p>
                            </div>
                        }
                        <input asp-for="FotoFile" type="file" class="form-control" />
                        <span asp-validation-for="FotoFile" class="text-danger"></span>
                        <div class="form-text">Sube una nueva imagen solo si deseas cambiarla</div>
                    </article>

                    <article class="d-flex gap-3 justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                        <input type="submit" value="Guardar cambios" class="btn btn-primary px-5" />
                    </article>
                </form>
            </div>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

