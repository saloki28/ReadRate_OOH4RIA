@model WebApplication_ReadRate.Models.LectorViewModel

@{
    ViewData["Title"] = "Index";
}

@* Obtenemos los roles *@

@{
    var usuarioRol = Context.Session.GetString("UsuarioRol");
    var usuarioNombre = Context.Session.GetString("UsuarioNombre");
}

@{
    var usuarioIdActual = Context.Session.GetInt32("UsuarioId");
    bool esPropioLector = Model != null && usuarioIdActual.HasValue && Model.IdUsuario == usuarioIdActual.Value;
}

@if (usuarioRol=="visitante")
{
    <header class="page-header">
        <h1>Perfil de Lector</h1>
    </header>

    <main class="container my-5">
        <article class="alert alert-info text-center">
            Inicia sesión para acceder a tu área personal.
        </article>
    </main>
}
else
{
    <header class="page-header">
        <h1>@(esPropioLector ? "TU ÁREA PERSONAL" : "Perfil de Lector")</h1>
    </header>

    <main class="container my-5">
        @if (Model != null)
        {
            @* Información del Lector *@
            <section class="card shadow-orange-lg mb-5">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <article class="col-md-3 text-center mb-3 mb-md-0">
                            <article class="autor-photo-wrapper">
                                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                                {
                                    <img src="@Model.FotoUrl" alt="Foto de @Model.NombreUsuario" class="rounded-circle" style="width: 180px; height: 180px; object-fit: cover; border: 4px solid #ff9800; box-shadow: 0 4px 12px rgba(255,111,0,0.3);">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 180px; height: 180px; border: 4px solid #ff9800; margin: 0 auto;">
                                        <span class="text-muted" style="font-size: 3rem;">@Model.NombreUsuario.Substring(0, 1).ToUpper()</span>
                                    </div>
                                }
                            </article>
                            <h3 class="mt-3 text-orange-dark">@Model.NombreUsuario</h3>
                        </article>
                        <article class="col-md-9">
                            <article class="row text-center">
                                <div class="col-md-3 mb-3 mb-md-0">
                                    <article class="stats-card">
                                        <h2 class="text-orange-dark mb-1">@Model.CantLibrosCurso</h2>
                                        <p class="text-muted mb-0">Libros En Curso</p>
                                    </article>
                                </div>
                                <div class="col-md-3 mb-3 mb-md-0">
                                    <article class="stats-card">
                                        <h2 class="text-orange-dark mb-1">@Model.CantLibrosLeidos</h2>
                                        <p class="text-muted mb-0">Libros Leídos</p>
                                    </article>
                                </div>
                                <div class="col-md-3 mb-3 mb-md-0">
                                    <article class="stats-card">
                                        <h2 class="text-orange-dark mb-1">@Model.CantAutoresSeguidos</h2>
                                        <p class="text-muted mb-0">Autores Seguidos</p>
                                    </article>
                                </div>
                                <div class="col-md-3">
                                    <article class="stats-card">
                                        <h2 class="text-orange-dark mb-1">@Model.CantClubsSuscritos</h2>
                                        <p class="text-muted mb-0">Clubes Suscritos</p>
                                    </article>
                                </div>
                            </article>
                            @if (esPropioLector)
                            {
                                <div class="row mt-4 align-items-center">
                                    <div class="col-6">
                                         <a asp-controller="Lector" @*asp-action="Edit"*@ asp-route-id="@Model.IdUsuario" class="btn-profile-edit w-100"> 
                                            <i class="fas fa-edit"></i> Editar Información
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a asp-controller="Lector" @*asp-action="Delete"*@ asp-route-id="@Model.IdUsuario" class="btn-profile-delete w-100">
                                            <i class="fas fa-trash-alt"></i> Eliminar Cuenta
                                        </a>
                                    </div>
                                </div>
                            }
                        </article>
                    </div>
                </div>
            </section>
        }
        else
        {
            <article class="alert alert-danger text-center">
                No se encontró información del lector.
            </article>
        }
    
    <!-- Sección de Lecturas en curso -->
    <section class="mb-5">
        <h2 class="section-title mb-4">LECTURAS EN CURSO</h2>
        <div class="books-grid">
            @if (Model != null && Model.LecturasGuardadas != null && Model.LecturasGuardadas.Any())
            {
                @foreach (var lectura in Model.LecturasGuardadas)
                {
                    <div class="book-card">
                        <div class="book-cover">
                            @if(!string.IsNullOrEmpty(lectura.FotoPortadaUrl))
                            {
                                <img src="@lectura.FotoPortadaUrl" alt="Portada de @lectura.Titulo" style="width: 100%; height: 100%; object-fit: contain;">
                            }
                        </div>
                        <div class="book-info">
                            <div class="book-title">@lectura.Titulo</div>
                            <div class="book-author">@lectura.NombreAutor</div>
                            <div class="book-actions">
                                <a class="btn-action" asp-controller="Libro" asp-action="Details" asp-route-id="@lectura.Id"><i class="fas fa-eye"></i> Ver Detalles</a>
                                @if (esPropioLector)
                                {
                                    <form asp-controller="Libro" asp-action="QuitarDeEnCurso" method="post" style="display:inline;">
                                        <input type="hidden" name="libroId" value="@lectura.Id" />
                                        <input type="hidden" name="returnUrl" value="perfil" />
                                        <button type="submit" class="btn-action delete" style="width: 100%"><i class="fas fa-trash-alt"></i> Eliminar de En Curso</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            @if (esPropioLector)
            {
                <a asp-controller="Libro" asp-action="Index" class="text-decoration-none">
                    <div class="book-card add-card">
                        <div class="add-content">
                            <i class="fas fa-plus-circle fa-4x text-orange mb-3"></i>
                            <p class="text-orange fw-bold mb-0">Añadir Libro</p>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- Sección de Libros Guardados -->
    <section class="mb-5">
        <h2 class="section-title mb-4">LIBROS LEÍDOS</h2>
        <div class="books-grid">
    @if (Model != null && Model.LibrosGuardados != null && Model.LibrosGuardados.Any())
    {
                @foreach (var libro in Model.LibrosGuardados)
                {
                    <div class="book-card">
                        <div class="book-cover">
                            @if (!string.IsNullOrEmpty(libro.FotoPortadaUrl))
                            {
                                <img src="@libro.FotoPortadaUrl" alt="Portada de @libro.Titulo" style="width: 100%; height: 100%; object-fit: contain;">
                            }
                        </div>
                        <div class="book-info">
                            <div class="book-title">@libro.Titulo</div>
                            <div class="book-author">@libro.NombreAutor</div>
                            <div class="book-actions">
                                <a class="btn-action" asp-controller="Libro" asp-action="Details" asp-route-id="@libro.Id"><i class="fas fa-eye"></i> Ver Detalles</a>
                                @if (esPropioLector)
                                {
                                    <form asp-controller="Libro" asp-action="QuitarDeGuardados" method="post" style="display:inline;">
                                        <input type="hidden" name="libroId" value="@libro.Id" />
                                        <input type="hidden" name="returnUrl" value="perfil" />
                                        <button type="submit" class="btn-action delete" style="width: 100%"><i class="fas fa-trash-alt"></i> Eliminar de Leídos</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
    }
        @if (esPropioLector)
        {
            <a asp-controller="Libro" asp-action="Index" class="text-decoration-none">
                <div class="book-card add-card">
                    <div class="add-content">
                        <i class="fas fa-plus-circle fa-4x text-orange mb-3"></i>
                        <p class="text-orange fw-bold mb-0">Añadir Libro</p>
                    </div>
                </div>
            </a>
        }
        </div>
    </section>

    <!-- Sección de Clubes Inscritos -->
    <section class="mb-5">
        <h2 class="section-title mb-4">CLUBES DE LECTURA SUSCRITOS</h2>
        <div class="books-grid">
    @if (Model != null && Model.ClubsInscritos != null && Model.ClubsInscritos.Any())
    {
                @foreach (var club in Model.ClubsInscritos)
                {
                    <div class="book-card">

                        <div class="book-info">
                            <div class="book-title">@club.Nombre</div>
                            <article class="user-photo-container">
                                <div class="user-photo-wrapper">
                                    @if(!string.IsNullOrEmpty(club.FotoUrl))
                                    {
                                        <img src="@club.FotoUrl" alt="Foto de @club.Nombre">
                                    }
                                    else
                                    {
                                        <div class="user-photo-placeholder">
                                            @club.Nombre.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                </div>
                            </article>
                            <div class="book-meta">
                                @if (club.PropietarioId == Model.IdUsuario)
                                {
                                    <strong>Propietario</strong>
                                }
                                else
                                {
                                    <strong>Miembro</strong>
                                }
                            </div>
                            <div class="book-actions">
                                <a class="btn-action" asp-controller="Club" asp-action="Details" asp-route-id="@club.Id"><i class="fas fa-eye"></i> Ver Detalles</a>
                                @if (esPropioLector && club.PropietarioId != Model.IdUsuario)
                                {
                                    <a class="btn-action delete" asp-controller="Club" asp-action="DeleteSuscripcion" asp-route-clubId="@club.Id"><i class="fas fa-user-minus"></i> Desuscribirse</a>
                                }
                                @if (esPropioLector && club.PropietarioId == Model.IdUsuario)
                                {
                                    <a class="btn-action delete" asp-controller="Club" asp-action="DeleteClub" asp-route-clubId="@club.Id"><i class="fas fa-trash-alt"></i> Eliminar Club</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            @if (esPropioLector)
            {
                <a asp-controller="Club" asp-action="Index" class="text-decoration-none">
                    <div class="book-card add-card">
                        <div class="add-content">
                            <i class="fas fa-plus-circle fa-4x text-orange mb-3"></i>
                            <p class="text-orange fw-bold mb-0">Añadir Club</p>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>
</main>
}
