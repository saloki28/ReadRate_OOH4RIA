@model WebApplication_ReadRate.Models.LectorViewModel

@{
    ViewData["Title"] = "Index";
}

@* Obtenemos los roles *@

@{
    var usuarioRol = Context.Session.GetString("UsuarioRol");
    var usuarioNombre = Context.Session.GetString("UsuarioNombre");
}

@{
    var usuarioIdActual = Context.Session.GetInt32("UsuarioId");
    bool esPropioLector = Model != null && usuarioIdActual.HasValue && Model.IdUsuario == usuarioIdActual.Value;
}

@if (usuarioRol=="visitante")
{
    <div class="page-header">
        <h1>Área Visitante</h1>
    </div>

    <div class="container">
        <div class="no-books">
            Inicia sesión para acceder a tu área personal.
        </div>
    </div>
}
else
{
    <div class="page-header">
        <h1>@(esPropioLector ? "TU ÁREA PERSONAL" : "Perfil de Lector")</h1>
    </div>

    <div class="container">
        @if (Model != null)
        {
            <div style="display: flex; gap: 2rem; align-items: flex-start; background: #fff; padding: 2rem; border-radius: 20px; box-shadow: 0 8px 24px rgba(255,111,0,0.1); margin-bottom: 3rem;">
                <div class="book-cover" style="width: 250px; height: 250px; flex-shrink: 0;">
                    @if (!string.IsNullOrEmpty(Model.FotoUrl))
                    {
                        <img src="@Model.FotoUrl" alt="Foto de @Model.NombreUsuario" style="width: 100%; height: 100%; object-fit: cover; border-radius: 15px;">
                    }
                    else
                    {
                        <span>FotoLector</span>
                    }
                </div>
                <div style="flex: 1;">
                    <div class="book-title" style="font-size: 2rem; margin-bottom: 0.5rem;">@Model.NombreUsuario</div>
                    <div class="book-author" style="font-size: 1.1rem; margin-bottom: 1.5rem;">@Model.Email</div>
                    <div class="book-meta" style="font-size: 1rem;">
                        <div class="book-meta-item">
                            <strong>Fecha de nacimiento:</strong> @Model.FechaNacimiento.ToString("dd/MM/yyyy")
                        </div>
                        <div class="book-meta-item">
                            <strong>Ciudad de residencia:</strong> @Model.CiudadResidencia
                        </div>
                        <div class="book-meta-item">
                            <strong>País de residencia:</strong> @Model.PaisResidencia
                        </div>
                        <div class="book-meta-item">
                            <strong>Cantidad de libros en curso:</strong> @Model.CantLibrosCurso
                        </div>
                        <div class="book-meta-item">
                            <strong>Cantidad de libros leídos:</strong> @Model.CantLibrosLeidos
                        </div>
                        <div class="book-meta-item">
                            <strong>Cantidad de autores seguidos:</strong> @Model.CantAutoresSeguidos
                        </div>
                        <div class="book-meta-item">
                            <strong>Cantidad de clubes suscritos:</strong> @Model.CantClubsSuscritos
                        </div>
                    </div>
                    
                    @* Aquí irán las partial views según si es propio perfil o no *@
                    @if (esPropioLector)
                    {
                        @* TODO: Crear partial "_LectorBotonesPropio.cshtml" *@
                        <div class="book-actions" style="margin-top: 1.5rem;">
                            <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn-action edit">Editar Perfil</a>
                            <a asp-action="Delete" asp-route-id="@Model.IdUsuario" class="btn-action delete">Borrar</a>
                        </div>
                    }
                    else
                    {
                        @* TODO: Crear partial "_LectorBotonesVisitante.cshtml" *@
                        <div class="book-actions" style="margin-top: 1.5rem;">
                            <a class="btn-action">Seguir</a>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="no-books">
                No se encontró información del lector.
            </div>
        }
    
    <!-- Sección de Lecturas en curso -->
    <hr class="separador">
    <div class="action-bar" style="margin-bottom: 1.5rem;">
        <h2 class="section-title">LECTURAS EN CURSO</h2>
    </div>
    @if (Model != null && Model.LecturasGuardadas != null && Model.LecturasGuardadas.Any())
    {
        <div style="margin-top: 3rem;">
            
            <div class="books-grid">
                @foreach (var lectura in Model.LecturasGuardadas)
                {
                    <div class="book-card">
                        <div class="book-cover">
                            @if(!string.IsNullOrEmpty(lectura.FotoPortadaUrl))
                            {
                                <img src="@lectura.FotoPortadaUrl" alt="Portada de @lectura.Titulo" style="width: 100%; height: 100%; object-fit: cover;">
                            }
                            else
                            {
                                <span>Portada</span>
                            }
                        </div>
                        <div class="book-info">
                            <div class="book-title">@lectura.Titulo</div>
                            <div class="book-author">@lectura.NombreAutor</div>
                            <div class="book-meta">
                                <strong>Género:</strong> @lectura.Genero <br />
                                <strong>Páginas:</strong> @lectura.NumPags <br/>
                                <strong>Valoración:</strong> @lectura.ValoracionMedia / 5
                            </div>
                            <div class="book-sinopsis">@lectura.Sinopsis</div>
                            <div class="book-actions">
                                <a class="btn-action" asp-controller="Libro" asp-action="Details" asp-route-id="@lectura.Id">Ver Detalles</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Sección de Libros Guardados -->
    <hr class="separador">
     <div class="action-bar" style="margin-bottom: 1.5rem;">
        <h2 class="section-title">LECTURAS GUARDADAS</h2>
    </div>
    @if (Model != null && Model.LibrosGuardados != null && Model.LibrosGuardados.Any())
    {
        <div style="margin-top: 3rem;">
            
            <div class="books-grid">
                @foreach (var libro in Model.LibrosGuardados)
                {
                    <div class="book-card">
                        <div class="book-cover">
                            @if(!string.IsNullOrEmpty(libro.FotoPortadaUrl))
                            {
                                <img src="@libro.FotoPortadaUrl" alt="Portada de @libro.Titulo" style="width: 100%; height: 100%; object-fit: cover;">
                            }
                            else
                            {
                                <span>Portada</span>
                            }
                        </div>
                        <div class="book-info">
                            <div class="book-title">@libro.Titulo</div>
                            <div class="book-author">@libro.NombreAutor</div>
                            <div class="book-meta">
                                <strong>Género:</strong> @libro.Genero <br />
                                <strong>Páginas:</strong> @libro.NumPags <br/>
                                <strong>Valoración:</strong> @libro.ValoracionMedia / 5
                            </div>
                            <div class="book-sinopsis">@libro.Sinopsis</div>
                            <div class="book-actions">
                                <a class="btn-action" asp-controller="Libro" asp-action="Details" asp-route-id="@libro.Id">Ver Detalles</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Sección de Clubes Inscritos -->
    <div class="action-bar" style="margin-bottom: 1.5rem;">
        <h2 class="section-title">CLUBES DE LECTURA SUSCRITOS</h2>
    </div>
    @if (Model != null && Model.ClubsInscritos != null && Model.ClubsInscritos.Any())
    {
        <div style="margin-top: 3rem;">
            
            <div class="books-grid">
                @foreach (var club in Model.ClubsInscritos)
                {
                    <div class="book-card">
                        <div class="book-cover">
                            @if(!string.IsNullOrEmpty(club.FotoUrl))
                            {
                                <img src="@club.FotoUrl" alt="Foto de @club.Nombre" style="width: 100%; height: 100%; object-fit: cover;">
                            }
                            else
                            {
                                <span>Foto del club</span>
                            }
                        </div>
                        @* <div class="book-info">
                            <div class="book-title">@club.Nombre</div>
                            <div class="book-meta">
                                <strong>Miembros:</strong> @club.Miembros / @club.NumeroMax <br />
                                <strong>Descripción:</strong> @club.Descripcion
                            </div>
                            <div class="book-actions">
                                <a class="btn-action" asp-controller="Club" asp-action="Details" asp-route-id="@club.Id">Ver Detalles</a>
                                @if(!string.IsNullOrEmpty(club.Enlace))
                                {
                                    <a class="btn-action" href="@club.Enlace" target="_blank">Discord</a>
                                }
                            </div>
                        </div> *@
                    </div>
                }
            </div>
        </div>
    }
</div>
}
