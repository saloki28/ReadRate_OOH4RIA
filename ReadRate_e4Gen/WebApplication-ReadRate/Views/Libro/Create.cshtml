@model WebApplication_ReadRate.Models.LibroViewModel

@{
    ViewData["Title"] = "Crear Libro";

    IEnumerable<SelectListItem> listaAutores = (IEnumerable<SelectListItem>)ViewData["listaAutores"];   
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Crear Libro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />    <link rel="stylesheet" href="~/css/readrate-styles.css" />
    </head>
<body>
    <header class="page-header">
        <h1>Crear Nuevo Libro</h1>
    </header>
    
    <main class="container my-5">
        <section class="card shadow-orange-lg">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <article class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej: El misterio de la casa abandonada" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                        <div class="form-text">Título de no más de 200 caracteres</div>
                    </article>
                    
                    <article class="mb-3">
                        <label asp-for="Genero" class="form-label"></label>
                        <input asp-for="Genero" class="form-control" placeholder="Ej: Ficción, Fantasía, Terror..." />
                        <span asp-validation-for="Genero" class="text-danger"></span>
                        <div class="form-text">Género literario de no más de 50 caracteres</div>
                    </article>
                    
                    <article class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EdadRecomendada" class="form-label"></label>
                            <input asp-for="EdadRecomendada" class="form-control" type="number" min="0" max="100" placeholder="Ej: 13" />
                            <span asp-validation-for="EdadRecomendada" class="text-danger"></span>
                            <div class="form-text">Edad mínima recomendada entre 0 y 100 años</div>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label asp-for="NumPags" class="form-label"></label>
                            <input asp-for="NumPags" class="form-control" type="number" min="1" max="10000" placeholder="Ej: 320" />
                            <span asp-validation-for="NumPags" class="text-danger"></span>
                            <div class="form-text">Número de páginas entre 1 y 10000</div>
                        </div>
                    </article>
                    
                    <article class="mb-3">
                        <label asp-for="Sinopsis" class="form-label"></label>
                        <textarea asp-for="Sinopsis" class="form-control" rows="5" placeholder="Escribe una breve descripción del libro..."></textarea>
                        <span asp-validation-for="Sinopsis" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 5000 caracteres</div>
                    </article>
                    
                    <article class="mb-3">
                        <label asp-for="FotoPortada" class="form-label"></label>
                        <input asp-for="FotoPortada" class="form-control" type="file" />
                        <span asp-validation-for="FotoPortada" class="text-danger"></span>
                        <div class="form-text">Imagen de la portada (formatos: .jpg, .png, .gif)</div>
                    </article>
                    
                    <article class="mb-3">
                        <label asp-for="ValoracionMedia" class="form-label"></label>
                        <input asp-for="ValoracionMedia" class="form-control" type="number" step="0.1" min="0" max="5" placeholder="Ej: 3.5" />
                        <span asp-validation-for="ValoracionMedia" class="text-danger"></span>
                        <div class="form-text">Valoración media entre 0 y 5 estrellas</div>
                    </article>
                    
                    <article class="mb-4">
                        <label asp-for="AutorId" class="form-label">Autor/a del Libro</label>
                        <select class="form-select" asp-for="AutorId" asp-items="listaAutores"></select>
                        <span asp-validation-for="AutorId" class="text-danger"></span>
                        <div class="form-text">Selecciona el autor/a del libro</div>
                    </article>
                    
                    <article class="d-flex gap-3 justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                        <input type="submit" value="Crear libro" class="btn btn-primary px-5" />
                    </article>
                </form>
            </div>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
