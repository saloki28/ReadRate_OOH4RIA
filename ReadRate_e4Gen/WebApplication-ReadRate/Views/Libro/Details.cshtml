@model WebApplication_ReadRate.Models.LibroViewModel

@{
    ViewData["Title"] = "Detalles del Libro";
    var lectorId = Context.Session.GetInt32("UsuarioId") ?? 0;
    var rolUsuario = Context.Session.GetString("UsuarioRol");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Detalles del Libro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
    </head>
<body>
    <header class="page-header">
        <h1>DETALLES DEL LIBRO</h1>
    </header>

    <main class="container my-5">
        <section class="details-card card shadow-lg">

            <article class="detail-row">
                <div class="detail-label">@Html.DisplayNameFor(model => model.Titulo)</div>
                <div class="detail-value">@Html.DisplayFor(model => model.Titulo)</div>
            </article>

            @if(Model != null && !string.IsNullOrEmpty(Model.FotoPortadaUrl))
            {
                <div class="detail-row-foto d-flex justify-content-center align-items-center mb-4">
                    <img src="@Model.FotoPortadaUrl" alt="Portada del libro" style="max-width: 215px; border: none; box-shadow: none;">
                </div>
            }

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">Nombre del Autor/a</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.NombreAutor)</div>
            </article>
        
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Sinopsis)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.Sinopsis)</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.ValoracionMedia)</div>
                <div class="detail-value text-end">
                    @if (Math.Floor(Model.ValoracionMedia) == 0)
                    {
                        <span>&#9734;</span>
                    }
                    else
                    {
                        @for (int i = 0; i < Math.Floor(Model.ValoracionMedia); i++)
                        {
                            <span>&#9733;</span>
                        }
                    }
                </div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Genero)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.Genero)</div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.EdadRecomendada)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.EdadRecomendada) años</div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.FechaPublicacion)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.FechaPublicacion)</div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.NumPags)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.NumPags) páginas</div>
            </article>
            
            @*cuando sea lector*@ 
            @if (rolUsuario == "lector") {

                <article class="detail-row d-flex justify-content-between py-3">
                    <a asp-controller="Reseña" asp-action="Create" asp-route-libroId="@Model.Id" asp-route-lectorId="@lectorId" class="btn btn-primary px-5">¡Rate!</a>
                    
                    @* Botón para lista de guardados *@
                    @if ((bool)ViewData["EstaEnGuardados"] == true)
                    {
                        <form asp-controller="Libro" asp-action="QuitarDeGuardados" method="post" style="display:inline;">
                            <input type="hidden" name="libroId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary px-5">Quitar de Libros Leídos</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Libro" asp-action="AgregarAGuardados" method="post" style="display:inline;">
                            <input type="hidden" name="libroId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary px-5">Añadir a Libros Leídos</button>
                        </form>
                    }

                    @* Botón para lista en curso *@
                    @if ((bool)ViewData["EstaEnCurso"] == true)
                    {
                        <form asp-controller="Libro" asp-action="QuitarDeEnCurso" method="post" style="display:inline;">
                            <input type="hidden" name="libroId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary px-5">Quitar de Libros en Curso</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Libro" asp-action="AgregarAEnCurso" method="post" style="display:inline;">
                            <input type="hidden" name="libroId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary px-5">Añadir a Libros en Curso</button>
                        </form>
                    }
                </article>
            }
            
        </section>

        <section class="details-card">
            <h2>RESEÑAS PUBLICADAS</h2>

            @if (Model.Resenas != null && Model.Resenas.Any())
            {
                foreach (var resena in Model.Resenas)
                {
                    <article class="details-card">
                        <div class="d-flex align-items-center mb-3">
                            @if (!string.IsNullOrEmpty(resena.LectorFoto))
                            {
                                <img src="@resena.LectorFoto" alt="Foto de @resena.LectorNombre" class="card-img-top" style="width: 50px; height: 50px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="card-img-top">
                                    <span class="detail-value" style="width: 50px; height: 50px;">@resena.LectorNombre?.Substring(0, 1).ToUpper()</span>
                                </div>
                            }
                            <strong>@resena.LectorNombre</strong>
                        </div>

                        <p class="detail-row">
                            <p class="detail-label">Opinión</p>
                            <p class="detail-value synopsis">@resena.Opinion</p>
                        </p>

                        <p class="detail-row">
                            <p class="detail-label">Valoración</p>
                            <p class="detail-value">
                                @if (Math.Floor(resena.Valoracion) == 0)
                                {
                                    <span>&#9734;</span>
                                }
                                else
                                {
                                    @for (int i = 0; i < Math.Floor(resena.Valoracion); i++)
                                    {
                                        <span>&#9733;</span>
                                    }
                                }
                            </p>
                        </p>

                        @* Botón para eliminar si la reseña es del lector logueado *@
                        @if (resena.LectorId == lectorId)
                        {
                            <form asp-controller="Reseña" asp-action="Delete" asp-route-id="@resena.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-primary px-5">Eliminar mi reseña</button>
                            </form>
                        }
                    </article>
                }
            }
            else
            {
                <p>No hay reseñas para este libro aún.</p>
            }
        </section>
    </main>
</body>
</html>
