@model WebApplication_ReadRate.Models.LibroViewModel

@{
    ViewData["Title"] = "Detalles del Libro";
    var lectorId = Context.Session.GetInt32("UsuarioId") ?? 0;
    var rolUsuario = Context.Session.GetString("UsuarioRol");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Detalles del Libro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Detalles del Libro</h1>
    </header>

    <main class="container my-5">
        <!-- Título del libro destacado -->
        <section class="text-center mb-4">
            <h2 class="section-title mb-4">@Model.Titulo</h2>
        </section>

        <!-- Información principal del libro -->
        <section class="mb-5">
            <div class="details-card">
                <div class="row">
                    <!-- Columna izquierda: Portada -->
                    <article class="col-md-3 text-center mb-4 mb-md-0 d-flex align-items-center">
                        @if(Model != null && !string.IsNullOrEmpty(Model.FotoPortadaUrl))
                        {
                            <div class="book-cover-container">
                                <img src="@Model.FotoPortadaUrl" alt="Portada de @Model.Titulo" class="book-cover-detail">
                            </div>
                        }
                        else
                        {
                            <div class="book-cover-placeholder">
                                <i class="fas fa-book fa-3x text-muted"></i>
                                <p class="text-muted mt-3">Sin portada</p>
                            </div>
                        }
                    </article>

                    <!-- Columna derecha: Información -->
                    <article class="col-md-9">
                        <article class="detail-row">
                            <div class="detail-label">Autor:</div>
                            <div class="detail-value">
                                <a asp-controller="Autor" asp-action="Index" asp-route-id="@Model.AutorId" class="btn-autor-profile d-inline-flex align-items-center gap-2 text-decoration-none">
                                    @if (!string.IsNullOrEmpty(Model.AutorFotoUrl))
                                    {
                                        <img src="@Model.AutorFotoUrl" alt="Foto de @Model.NombreAutor" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover; border: 2px solid #ff9800;">
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-size: 1.2rem; font-weight: bold; border: 2px solid #ff9800;">
                                            @Model.NombreAutor?.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                    <span class="fw-semibold">@Model.NombreAutor</span>
                                </a>
                            </div>
                        </article>

                        <article class="detail-row">
                            <div class="detail-label">Sinopsis:</div>
                            <div class="detail-value">@Model.Sinopsis</div>
                        </article>

                        <article class="detail-row">
                            <div class="detail-label">Valoración media:</div>
                            <div class="detail-value">
                                @await Html.PartialAsync("_StarRating", Model.ValoracionMedia)
                            </div>
                        </article>

                        <article class="detail-row">
                            <div class="detail-label">Género:</div>
                            <div class="detail-value">@Model.Genero</div>
                        </article>

                        <article class="detail-row">
                            <div class="detail-label">Edad recomendada:</div>
                            <div class="detail-value">@Model.EdadRecomendada años</div>
                        </article>

                        <article class="detail-row">
                            <div class="detail-label">Fecha de publicación:</div>
                            <div class="detail-value">@Model.FechaPublicacion.ToString("dd/MM/yyyy")</div>
                        </article>

                        <article class="detail-row">
                            <div class="detail-label">Páginas:</div>
                            <div class="detail-value">@Model.NumPags</div>
                        </article>

                        @* Botones de acción para lectores *@
                        @if (rolUsuario == "lector")
                        {
                            <article class="d-flex flex-wrap gap-3 mt-4 justify-content-center">
                                <a asp-controller="Reseña" asp-action="Create" asp-route-libroId="@Model.Id" asp-route-lectorId="@lectorId" class="btn-action">
                                    ¡Rate!
                                </a>

                                @if ((bool)ViewData["EstaEnGuardados"] == true)
                                {
                                    <form asp-controller="Libro" asp-action="QuitarDeGuardados" method="post" style="display:inline;">
                                        <input type="hidden" name="libroId" value="@Model.Id" />
                                        <button type="submit" class="btn-action delete">Quitar de Libros Leídos</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Libro" asp-action="AgregarAGuardados" method="post" style="display:inline;">
                                        <input type="hidden" name="libroId" value="@Model.Id" />
                                        <button type="submit" class="btn-action">Añadir a Libros Leídos</button>
                                    </form>
                                }

                                @if ((bool)ViewData["EstaEnCurso"] == true)
                                {
                                    <form asp-controller="Libro" asp-action="QuitarDeEnCurso" method="post" style="display:inline;">
                                        <input type="hidden" name="libroId" value="@Model.Id" />
                                        <button type="submit" class="btn-action delete">Quitar de Libros en Curso</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Libro" asp-action="AgregarAEnCurso" method="post" style="display:inline;">
                                        <input type="hidden" name="libroId" value="@Model.Id" />
                                        <button type="submit" class="btn-action">Añadir a Libros en Curso</button>
                                    </form>
                                }
                            </article>
                        }
                    </article>
                </div>
            </div>
        </section>

        <!-- Sección de reseñas -->
        <section>
            <h2 class="section-title mb-4">Reseñas Publicadas</h2>

            @if (Model.Resenas != null && Model.Resenas.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var resena in Model.Resenas)
                    {
                        <div class="col">
                            <article class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <!-- Foto y nombre del usuario -->
                                    <div class="d-flex align-items-center mb-3">
                                        @if (!string.IsNullOrEmpty(resena.LectorFoto))
                                        {
                                            <img src="@resena.LectorFoto" alt="Foto de @resena.LectorNombre" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; font-size: 1.5rem; font-weight: bold;">
                                                @resena.LectorNombre?.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <strong class="text-dark">@resena.LectorNombre</strong>
                                    </div>

                                    <!-- Opinión -->
                                    <div class="mb-3">
                                        <p class="text-muted small mb-1" style="color: #ef7d19;">Opinión personal:</p>
                                        <p class="card-text">@resena.Opinion</p>
                                    </div>

                                    <!-- Valoración con estrellas -->
                                    <div class="mb-3">
                                        <p class="text-muted small mb-1" style="color: #ef7d19;">Valoración:</p>
                                        <partial name="_StarRating" model="resena.Valoracion" />
                                    </div>

                                    <!-- Botón eliminar si es del usuario -->
                                    @if (resena.LectorId == lectorId)
                                    {
                                        <form asp-controller="Reseña" asp-action="Delete" asp-route-id="@resena.Id" method="post">
                                            <button type="submit" class="btn-action delete w-100" onclick="return confirm('¿Estás seguro de eliminar tu reseña?');">
                                                Eliminar mi reseña
                                            </button>
                                        </form>
                                    }
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-danger" style="background: #ffffff; border-radius: 15px; color: #999; border: none;">
                    No hay reseñas para este libro aún. ¡Sé el primero en valorarlo!
                </div>
            }
        </section>
    </main>
</body>
</html>
