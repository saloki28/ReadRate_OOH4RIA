@model WebApplication_ReadRate.Models.LibroFiltrosViewModel

@{
    ViewData["Title"] = "Index";
    var rolUsuario = Context.Session.GetString("UsuarioRol");
}
<header class="page-header">
    <h1>Listado de Libros</h1>
</header>

<section class="container">
    <!--FORMULARIO-->
    <article class="card mb-4 shadow-sm">
        <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
            <h2 class="section-title mb-0">Buscador de Libros</h2>
        </article>
        <article class="card-body">
            <form asp-action="Index" method="get">
                <div class="row">
                    <div class="col-12">
                        <article class="mb-3">
                            <label for="TituloFiltro" class="form-label">Título</label>
                            <input type="text" name="TituloFiltro" id="TituloFiltro" class="form-control"
                                   placeholder="Escribe el título del libro..." value="@Model?.TituloFiltro" />
                        </article>

                        <article class="mb-3">
                            <label for="GeneroFiltro" class="form-label">Género</label>
                            <select name="GeneroFiltro" id="GeneroFiltro" class="form-select" asp-items="@Model?.Generos">
                                <option value="">-- Todos los géneros --</option>
                            </select>
                        </article>

                        <article class="mb-3">
                            <label for="EdadRecomendadaFiltro" class="form-label">Edad Mínima</label>
                            <input type="number" name="EdadRecomendadaFiltro" id="EdadRecomendadaFiltro" class="form-control"
                                   placeholder="Ej: 12" min="0" max="100" step="1" value="@Model?.EdadRecomendadaFiltro" />
                        </article>

                        <article class="mb-3">
                            <label for="NombreAutorFiltro" class="form-label">Autor</label>
                            <input type="text" name="NombreAutorFiltro" id="NombreAutorFiltro" class="form-control"
                                   placeholder="Nombre del autor..." value="@Model?.NombreAutorFiltro" />
                        </article>

                        <article class="mb-3">
                            <label for="ValoracionMediaFiltro" class="form-label">Valoración Mínima</label>
                            <input type="number" name="ValoracionMediaFiltro" id="ValoracionMediaFiltro" class="form-control"
                                   placeholder="Ej: 4.5" min="0" max="5" step="0.5" value="@Model?.ValoracionMediaFiltro" />
                        </article>

                        <article class="d-flex gap-2 justify-content-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
                            <button type="submit" class="btn btn-primary">Buscar</button>
                        </article>
                    </div>
                </div>
            </form>
        </article>
    </article>
    
    <hr class="hr" style= "margin-top: 4em; margin-bottom: 4em;" />

    <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
        <h2 class="section-title mb-0">Resultados de Búsqueda</h2>
    </article>

    <article class="row g-4">
        @if (Model != null && Model.Libros != null && Model.Libros.Any())
        {
            foreach (var item in Model.Libros)
            {
                <article class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 d-flex flex-column">
                        <article class="book-cover">
                            @if (!string.IsNullOrEmpty(item.FotoPortadaUrl))
                            {
                                <img src="@item.FotoPortadaUrl" alt="Portada de @item.Titulo" class="card-img-top" style="height: 250px; object-fit: contain;">
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                    <span class="text-muted">Sin portada</span>
                                </div>
                            }
                        </article>
                        <article class="card-body d-flex flex-column">
                            <h5 class="card-title text-orange-dark">@Html.DisplayFor(modelItem => item.Titulo)</h5>
                            <div class="card-text small mb-3 flex-grow-1">
                                <p class="mb-1">
                                    <strong>Autor/a:</strong> @Html.DisplayFor(modelItem => item.NombreAutor)
                                </p>
                                <p class="mb-1">
                                    <strong>Género:</strong> @Html.DisplayFor(modelItem => item.Genero)
                                </p>
                                <p class="mb-1">
                                    <strong>Edad:</strong> +@Html.DisplayFor(modelItem => item.EdadRecomendada) años
                                </p>
                                <p class="mb-1">
                                    <strong>Páginas:</strong> @Html.DisplayFor(modelItem => item.NumPags)
                                </p>
                                <p class="mb-1">
                                    <strong>Publicado:</strong> @Html.DisplayFor(modelItem => item.FechaPublicacion)
                                </p>
                                <p class="mb-1">
                                    <strong>Valoración:</strong> <partial name="_StarRating" model="item.ValoracionMedia" />
                                </p>
                                <p class="mb-1">
                                    <strong>Sinopsis:</strong> @Html.DisplayFor(modelItem => item.Sinopsis)
                                </p>
                            </div>
                            @if (rolUsuario == "administrador")
                            {
                                <article class="d-flex gap-2 mt-auto">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center">Detalles</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit flex-fill text-center">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete flex-fill text-center">Borrar</a>
                                </article>
                            }
                            else
                            {
                                <article class="d-flex gap-2 mt-auto">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center">Detalles</a>
                                </article>
                            }
                        </article>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="col-12">
                <div class="alert alert-info text-center">
                    No hay libros en el listado. ¡Añade el primero!
                </div>
            </article>
        }
    </article>
</section>