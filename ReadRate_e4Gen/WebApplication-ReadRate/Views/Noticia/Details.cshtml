@model WebApplication_ReadRate.Models.NoticiaViewModel

@{
    ViewData["Title"] = "Detalles de la Noticia";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Detalles de la Noticia</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Detalles de la Noticia</h1>
    </header>

    <main class="container my-5">
        <section class="details-card card shadow-lg">
            
            @if (!string.IsNullOrEmpty(Model.Foto))
            {
                <div class="detail-row-foto d-flex justify-content-center align-items-center mb-4">
                    <img src="@Model.Foto" alt="Foto de la noticia" style="max-width: 300px;">
                </div>
            }

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Titulo)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.Titulo)</div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.FechaPublicacion)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.FechaPublicacion)</div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.TextoContenido)</div>
                <div class="detail-value text-end">@Html.DisplayFor(model => model.TextoContenido)</div>
            </article>

            <article class="form-actions d-flex gap-3 justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i>Volver al listado</a>
                @if (Context.Session.GetString("UsuarioRol") == "administrador")
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-5">Editar noticia</a>
                }
            </article>
        </section>
    </main>
</body>
</html>
