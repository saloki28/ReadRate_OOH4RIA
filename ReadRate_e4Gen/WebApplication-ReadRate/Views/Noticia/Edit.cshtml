@model WebApplication_ReadRate.Models.NoticiaViewModel

@{
    ViewData["Title"] = "Editar Noticia";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Editar Noticia</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Editar Noticia</h1>
    </header>

    <main class="container my-5">
        <section class="card shadow-orange-lg">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Foto" />

                    <article class="mb-3">
                        <label asp-for="Titulo" class="form-label"></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Introduce el titular..." />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                        <div class="form-text">Título de no más de 255 caracteres</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="TextoContenido" class="form-label"></label>
                        <textarea asp-for="TextoContenido" class="form-control" rows="4" placeholder="Escribe aquí el cuerpo de la noticia..."></textarea>
                        <span asp-validation-for="TextoContenido" class="text-danger"></span>
                        <div class="form-text">Texto de máximo 255 caracteres</div>
                    </article>

                    <!-- FOTO -->
                    <article class="mb-4">
                        <label asp-for="FotoFichero" class="form-label">Cambiar Imagen de Portada</label>
                        <input asp-for="FotoFichero" class="form-control" type="file" accept="image/*" />
                        <span asp-validation-for="FotoFichero" class="text-danger"></span>
                        <div class="form-text">Deja en blanco para mantener la foto actual</div>
                    </article>

                    <article class="d-flex gap-3 justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i>Volver al listado</a>
                        <input type="submit" value="Guardar cambios" class="btn btn-primary px-5" />
                    </article>
                </form>
            </div>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
