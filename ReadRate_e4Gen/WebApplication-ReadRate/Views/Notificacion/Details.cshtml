@model WebApplication_ReadRate.Models.NotificacionViewModel

@{
    ViewData["Title"] = "Detalles de la Notificación";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Detalles de la Notificación</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Detalles de la Notificación</h1>
    </header>
    
    <main class="container my-5">
        <section class="details-card card shadow-lg">
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Concepto)</div>
                <div class="detail-value text-end">@Model.Concepto.Replace("_", " ").ToUpper()</div>
            </article>

            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Titulo)</div>
                <div class="detail-value text-end">@Model.Titulo</div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">@Html.DisplayNameFor(model => model.Texto)</div>
                <div class="detail-value text-end">@Model.Texto</div>
            </article>
            
            <article class="detail-row d-flex justify-content-between py-3">
                <div class="detail-label fw-semibold">Fecha</div>
                <div class="detail-value text-end">@Model.Fecha.ToString("dd/MM/yyyy")</div>
            </article>
            
            <article class="form-actions d-flex gap-3 justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-5">Editar notificación</a>
            </article>
        </section>
    </main>
</body>
</html>
