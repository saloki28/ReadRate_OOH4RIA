@model IEnumerable<WebApplication_ReadRate.Models.NotificacionViewModel>

@{
    ViewData["Title"] = "Index";
}
<header class="page-header">
    <h1>Listado de Notificaciones</h1>
</header>

<section class="container">
    <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
        <h2 class="section-title mb-0">Todas las Notificaciones</h2>
        <a asp-action="Create" class="btn-create"><i class="fas fa-plus"></i> Crear nueva notificación</a>
    </article>
    
    <article class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <article class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 d-flex flex-column">
                        <div class="card-header bg-orange-light text-white">
                            <div class="fw-bold">@item.Concepto.Replace("_", " ").ToUpper()</div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-orange-dark">@Html.DisplayFor(modelItem => item.Titulo)</h5>
                            <p class="card-text small mb-2">@Html.DisplayFor(modelItem => item.Texto)</p>
                            <div class="card-text small mb-3 flex-grow-1">
                                <div class="mb-1"><strong>Fecha:</strong> @Html.DisplayFor(modelItem => item.Fecha)</div>
                            </div>
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center"><i class="fas fa-eye"></i> Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit flex-fill text-center"><i class="fas fa-edit"></i> Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete flex-fill text-center"><i class="fas fa-trash-alt"></i> Borrar</a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="col-12">
                <div class="alert alert-info text-center" style="background: #ffffff; border-radius: 15px; color: #999; border: none;">
                    No hay notificaciones en el listado.
                </div>
            </article>
        }
    </article>
</section>
