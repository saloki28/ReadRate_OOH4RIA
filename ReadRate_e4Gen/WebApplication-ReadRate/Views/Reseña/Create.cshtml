@model WebApplication_ReadRate.Models.ReseñaViewModel

@{
    ViewData["Title"] = "Create";

    IEnumerable<SelectListItem> librosItem = (IEnumerable<SelectListItem>)ViewData["libItems"];
    IEnumerable<SelectListItem> lectorItem = (IEnumerable<SelectListItem>)ViewData["lecItems"];
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Crear Reseña</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body>
    <header class="page-header">
        <h1>Crear Nueva Reseña</h1>
    </header>

    <main class="container my-5">
        <section class="card shadow-orange-lg">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <article class="mb-3">
                        <label asp-for="Valoracion" class="form-label"></label>
                        <input asp-for="Valoracion" class="form-control" min="0" max="5" step="0.1" type="number" />
                        <span asp-validation-for="Valoracion" class="text-danger"></span>
                        <div class="form-text">Valora el libro (número entre 0 y 5)</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="Opinion" class="form-label"></label>
                        <textarea asp-for="Opinion" class="form-control" rows="4" placeholder="Escribe tu opinión aquí..." maxlength="600"></textarea>
                        <span asp-validation-for="Opinion" class="text-danger"></span>
                        <div class="form-text">Da tu opinión sobre el libro (máximo 600 caracteres)</div>
                    </article>

                    <article class="mb-3">
                        <label asp-for="LibroId" class="form-label"></label>
                        <select class="form-select" asp-for="LibroId" asp-items="librosItem"></select>
                        <span asp-validation-for="LibroId" class="text-danger"></span>
                        <div class="form-text">Selecciona el libro sobre el que vas a dar tu opinión</div>
                    </article>

                    <article class="mb-4">
                        <label asp-for="LectorId" class="form-label"></label>
                        <select class="form-select" asp-for="LectorId" asp-items="lectorItem"></select>
                        <span asp-validation-for="LectorId" class="text-danger"></span>
                        <div class="form-text">Selecciona el autor de la reseña</div>
                    </article>

                    <article class="d-flex gap-3 justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                        <input type="submit" value="Crear reseña" class="btn btn-primary px-5" />
                    </article>
                </form>
            </div>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

