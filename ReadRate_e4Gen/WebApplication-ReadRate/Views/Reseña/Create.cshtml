@model WebApplication_ReadRate.Models.ReseñaViewModel

@{
    ViewData["Title"] = "Create";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Crear Reseña</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
    </head>
<body>
    <header class="page-header">
        <h1>DALE TU RATING A @Model.LibroNombre.ToUpper()</h1>
    </header>

    <main class="container">
        <section class="form-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <input type="hidden" asp-for="LibroId" />
                <input type="hidden" asp-for="FechaPublicacion" />
                <input type="hidden" asp-for="LectorId" />

                <article class="form-group">
                    <label asp-for="Valoracion" class="control-label"></label>
                    <input asp-for="Valoracion" class="form-control" min="0" max="5" step="0.1" type="number" />
                    <span asp-validation-for="Valoracion" class="text-danger"></span>
                    <small class="form-hint">Valora el libro (número entre 0 y 5)</small>
                </article>

                <article class="form-group">
                    <label asp-for="Opinion" class="control-label"></label>
                    <textarea asp-for="Opinion" class="form-control" maxlength="600" placeholder="Escribe tu opinión aquí..."></textarea>
                    <span asp-validation-for="Opinion" class="text-danger"></span>
                    <small class="form-hint">Da tu opinión sobre el libro (máximo 600 caracteres)</small> 
                </article>

                <article class="form-actions">
                    <input type="submit" value="Publicar" class="btn btn-primary" />
                    <a asp-controller="Libro" asp-action="Details" asp-route-id="@Model.LibroId" class="btn btn-primary">Cancelar</a>
                </article>
            </form>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

