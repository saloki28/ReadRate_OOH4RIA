@model IEnumerable<WebApplication_ReadRate.Models.ReseñaViewModel>

@{
    ViewData["Title"] = "Index";
}
<header class="page-header">
    <h1>Reseñas recientes </h1>
</header>

<section class="container">
    <article class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-3 shadow-orange">
        <h2 class="section-title mb-0">Listado de Reseñas</h2>
        <a asp-action="Create" class="btn-create"><i class="fas fa-plus"></i> Crear nueva reseña</a>
    </article>

    <article class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <article class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 d-flex flex-column">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-orange-dark">@Html.DisplayFor(modelItem => item.LibroNombre)</h5>
                            <div class="card-text small mb-3 flex-grow-1">
                                <div class="mb-1"><strong>Valoración:</strong> @Html.DisplayFor(modelItem => item.Valoracion) / 5</div>
                                <div class="mb-1"><strong>Opinión:</strong> @Html.DisplayFor(modelItem => item.Opinion)</div>
                                <div class="mb-1"><strong>Lector reseñador:</strong> @Html.DisplayFor(modelItem => item.LectorNombre)</div>
                                <div class="mb-1"><strong>Fecha:</strong> @Html.DisplayFor(modelItem => item.FechaPublicacion)</div>
                            </div>
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action flex-fill text-center"><i class="fas fa-eye"></i> Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit flex-fill text-center"><i class="fas fa-edit"></i> Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete flex-fill text-center"><i class="fas fa-trash-alt"></i> Borrar</a>
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="col-12">
                <div class="alert alert-info text-center">
                    No hay reseña en el listado. ¡Añade la primera!
                </div>
            </article>
        }
    </article>
</section>
