@model IEnumerable<WebApplication_ReadRate.Models.AutorViewModel>

<div class="books-grid">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="book-card">
                <div class="book-cover">
                    @if (!string.IsNullOrEmpty(item.FotoUrl))
                    {
                        <img src="@item.FotoUrl" alt="Foto del autor @item.NombreUsuario" style="width: 110%; height: 110%; object-fit: contain;">
                    }
                    else
                    {
                        <span>FotoPerfil</span>
                    }
                </div>
                <div class="book-info">
                    <div class="book-title">@Html.DisplayFor(modelItem => item.NombreUsuario)</div>
                    @* <div class="book-author">@Html.DisplayFor(modelItem => item.AutorPublicador.NombreUsuario)</div> *@
                    <strong>Libros publicados:</strong> @Html.DisplayFor(modelItem => item.CantidadLibrosPublicados) <br />
                    <div class="book-actions">
                        <a class="btn" asp-controller="Autor" asp-action="Index" asp-route-id="@item.IdUsuario">Visitar perfil</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="no-books">
            No existen autores best seller por ahora
        </div>
    }
</div>