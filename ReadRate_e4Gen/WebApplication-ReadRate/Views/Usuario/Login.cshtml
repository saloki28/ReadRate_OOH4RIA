@model WebApplication_ReadRate.Models.UsuarioViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Inicio de Sesión</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />    
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body class="login-page">
    <main class="login-container">
        <section class="login-card">
            <article class="logo-section">
                <div class="logo-icon">
                    <img src="~/images/decoracionWeb/logoRR.webp" alt="Logo Read&Rate" style="width: 120px; height: 120px; object-fit: contain; margin-bottom: 0.5em; margin-top: 0.5em;" />
                </div>
                <h1 class="app-title">Read&Rate</h1>
                <p class="welcome-message">¡Bienvenido/a! Por favor, introduce tus credenciales para acceder a la web</p>
            </article>
            
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                
                <article class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="Introduce tu correo electrónico" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </article>
                
                <article class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="Introduce tu contraseña" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </article>
                
                <article class="form-group">
                    <input type="submit" value="Iniciar Sesión" class="btn btn-primary" />
                </article>
            </form>
            
            <div style="text-align: center; margin-top: 1rem;">
                <a href="@Url.Action("HomeVisitante", "Usuario")" class="btn btn-secondary">
                     Entrar como Visitante
                </a>
            </div>
            
            <p class="footer-text">Tu plataforma de lectura y valoración de libros</p>
        </section>
    </main>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

