@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Read&Rate - Crear Cuenta</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />    
    <link rel="stylesheet" href="~/css/readrate-styles.css" />
</head>
<body class="login-page">
    <main class="login-container">
        <section class="login-card">
            <article class="logo-section">
                <div class="logo-icon">
                    <img src="~/images/decoracionWeb/logoRR.webp" alt="Logo Read&Rate" style="width: 120px; height: 120px; object-fit: contain; margin-bottom: 0.5em; margin-top: 0.5em;" />
                </div>
                <h1 class="app-title">Read&Rate</h1>
                <p class="welcome-message">Selecciona tu rol en la plataforma</p>
            </article>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <!-- Rol en la plataforma -->
                <div class="form-group">
                    <label class="control-label fw-semibold text-center d-block mb-3" style="font-size: 1.1rem; color: #e65100;">¿Cómo quieres usar Read&Rate?</label>
                    <div class="rol-selector">
                        <div class="rol-option">
                            <input type="radio" id="rolLector" name="rol" value="lector" />
                            <label for="rolLector" class="rol-label">
                                <div style="font-size: 1.1rem;">Lector</div>
                                <small class="text-muted" style="font-weight: normal;">Descubre y reseña libros</small>
                            </label>
                        </div>
                        <div class="rol-option">
                            <input type="radio" id="rolAutor" name="rol" value="autor" />
                            <label for="rolAutor" class="rol-label">
                                <div style="font-size: 1.1rem;">Autor</div>
                                <small class="text-muted" style="font-weight: normal;">Da visibilidad a tus obras</small>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Botones -->
                <div class="form-group">
                    <button type="submit" class="btn btn-primary w-100">Continuar</button>
                </div>
            </form>

            <div class="text-center mt-4 pt-4 border-top">
                <p class="text-muted mb-2">¿Ya tienes cuenta?</p>
                <a href="@Url.Action("Login", "Usuario")" class="btn btn-outline-create">Iniciar Sesión</a>
            </div>
        </section>

        <section class="form-group mt-3">
            <a href="javascript:history.back()" class="btn btn-back-custom w-100">Volver atrás</a>
        </section>
    </main>
</body>
</html>
</html>
